#include <stdio.h>
int main(){
	int n=0;
	int l=0;
	scanf("%d %d",&n,&l);
	int a[1000];
	for(int i=0;i<l*2;i=i+2){
		scanf("%d %d",&a[i],&a[i+1]);
	}
	int t=0;
	for(int j=0;j<=n;j++){
		for(int k=0;k<l*2;k=k+2){
			if(j>=a[k]&&j<=a[k+1]){
				t++;
				break;
			}
			
		}
	}
	printf("%d\n",n-t+1);
	return 0;
}
